# Kernel config fragment for USB/IP (vhci-hcd) and common USB class drivers
# in Haven's arm64 UML guest (uml-guest-5, #613).
#
# Merged onto `make ARCH=um SUBARCH=arm64 defconfig` by build-bionic.sh.
# Everything is =y because CONFIG_MODULES is disabled in the static UML build.

# IOMEM and DMA emulation required by usbcore on ARCH=um.
CONFIG_UML_IOMEM_EMULATION=y
CONFIG_UML_DMA_EMULATION=y

# Core USB + USB/IP virtual host controller (vhci_hcd).
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USBIP_CORE=y
CONFIG_USBIP_VHCI_HCD=y

# USB mass storage (BOT + UAS) for flash drives and external SSDs.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# UVC webcams (V4L2 /dev/video*).
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_USB_VIDEO_CLASS=y

# USB Audio (UAC1/UAC2 ALSA /dev/snd/*).
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y

# USB HID and FIDO2 security keys (/dev/hidraw*).
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HIDRAW=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_USB_HIDDEV=y

# USB CDC-ACM and serial adapters (/dev/ttyACM*, /dev/ttyUSB*).
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_PL2303=y

# USB Ethernet and Realtek 8821AU/8811AU WiFi.
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_RTL8152=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=y
CONFIG_RTW88_USB=y
CONFIG_RTW88_8821AU=y
