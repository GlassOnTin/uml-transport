+static void sigsys_diag(int sig, siginfo_t *si, void *uc)
+{
+	char buf[64];
+	int n;
+
+	(void)sig;
+	(void)uc;
+	n = snprintf(buf, sizeof(buf), "SIGSYS: blocked syscall %d\n",
+		     si->si_syscall);
+	if (write(2, buf, n) != n)
+		/* nothing more we can do here */
+		;
+	_exit(159);
+}
